"""Forest Fire Simulation"""

import random
import sys
import time

try:
    import bext
except ImportError:
    print("This program requires the bext module.")
    print("Install it using:")
    print("pip install bext")
    sys.exit()

# Forest settings
WIDTH = 79
HEIGHT = 22

TREE = 'A'
FIRE = 'W'
EMPTY = ' '

# Simulation settings
INITIAL_TREE_DENSITY = 0.20
GROW_CHANCE = 0.01
FIRE_CHANCE = 0.01

PAUSE_LENGTH = 0.5


def main():
    forest = createNewForest()
                 
    bext.clear()

    while True:
        
        displayForest(forest)

        # Create the next forest
        nextForest = {
            'width': forest['width'],
            'height': forest['height']
        }

        # Check every position
        for x in range(forest['width']):
            for y in range(forest['height']):

                # If already changed, skip it
                if (x, y) in nextForest:
                    continue

                # Empty space can grow a tree
                if (forest[(x, y)] == EMPTY
                        and random.random() <= GROW_CHANCE):

                    nextForest[(x, y)] = TREE

                # Tree can catch fire from lightning
                elif (forest[(x, y)] == TREE
                      and random.random() <= FIRE_CHANCE):

                    nextForest[(x, y)] = FIRE

                # Fire spreads to nearby trees
                elif forest[(x, y)] == FIRE:

                    for ix in range(-1, 2):
                        for iy in range(-1, 2):

                            if forest.get((x + ix, y + iy)) == TREE:
                                nextForest[(x + ix, y + iy)] = FIRE

                    # Burning tree becomes empty
                    nextForest[(x, y)] = EMPTY

                else:
                    # Keep the existing state
                    nextForest[(x, y)] = forest[(x, y)]

        # Move to the next generation
        forest = nextForest

        time.sleep(PAUSE_LENGTH)


def createNewForest():
    """Create a new forest."""

    forest = {
        'width': WIDTH,
        'height': HEIGHT
    }

    for x in range(WIDTH):
        for y in range(HEIGHT):

            if (random.random() * 100) <= INITIAL_TREE_DENSITY:
                forest[(x, y)] = TREE
            else:
                forest[(x, y)] = EMPTY

    return forest


def displayForest(forest):
    """Display the forest."""

    bext.goto(0, 0)

    for y in range(forest['height']):
        for x in range(forest['width']):

            if forest[(x, y)] == TREE:
                bext.fg('green')
                print(TREE, end='')

            elif forest[(x, y)] == FIRE:
                bext.fg('red')
                print(FIRE, end='')

            elif forest[(x, y)] == EMPTY:
                print(EMPTY, end='')

        print()

    bext.fg('reset')

    print(
        'Grow chance: {}% '.format(GROW_CHANCE * 100),
        end=''
    )

    print(
        'Lightning chance: {}%'.format(FIRE_CHANCE * 100)
    )

    print('Press Ctrl-C to quit.')


# Run the program
if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        sys.exit()# Auto detect text files and perform LF normalization
